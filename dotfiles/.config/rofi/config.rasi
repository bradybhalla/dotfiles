@import "catppuccin-frappe"

configuration {
  show-icons: true;
  font: "MesloLGS Nerd Font 12";
  // #838ba7 is catppuccin-frappe overlay1
  drun-display-format: "{name} [<span foreground='#838ba7'>{generic}</span>]";
}

// only overrides of rofi's default theme (rofi -no-config -dump-theme)

* {
  background:                 @mantle;
  foreground:                 @text;
  // alternate rows look like normal rows
  lightbg:                    @background;
  border-color:               @sapphire;
  separatorcolor:             @border-color;
  selected-normal-background: @surface0;
  selected-normal-foreground: @text;
  input-fg:                   @overlay1;
}
element {
    padding:       8px;
    spacing:       12px;
    border-radius: 8px;
}
element-text {
    vertical-align: 0.5;
}
element-icon {
    size: 1.5em;
}
window {
    width:         30%;
    border:        2px;
    border-radius: 10px;
}
listview {
    padding:   5px 0px 0px;
    scrollbar: false;
    border:    2px solid 0px 0px;
}
inputbar {
    padding:  12px;
    children: [ "prompt","textbox-prompt-colon","entry","num-filtered-rows","textbox-num-sep","num-rows","case-indicator" ];
}
prompt, textbox-prompt-colon, entry, num-filtered-rows, textbox-num-sep, num-rows, case-indicator {
    font:           "MesloLGS Nerd Font 16";
    vertical-align: 0.5;
}
prompt, textbox-prompt-colon, num-filtered-rows, textbox-num-sep, num-rows, case-indicator {
    text-color: @input-fg;
}
entry {
    placeholder-color: @input-fg;
}
